PROGRAM main
  VAR
    SAFETY_OK : BOOL; (* ESTOP_OK AND GUARD_CLOSED AND MODE_AUTO *)
    HB_COUNT : UINT; (* PLC heartbeat counter, wraps at 65535 *)
    HB_LAST : WORD; (* ROBOT_HEARTBEAT as seen on the previous scan *)
    HB_CHANGED : BOOL; (* ROBOT_HEARTBEAT moved since the previous scan *)
    HB_WATCHDOG : TON; (* Times how long ROBOT_HEARTBEAT has been frozen *)
    HB_STALE : BOOL; (* ROBOT_HEARTBEAT frozen for longer than the watchdog time *)
    RECIPE_LOADED : BOOL; (* RECIPE <> 0: a job has been requested *)
    RECIPE_GE_MIN : BOOL; (* RECIPE >= first approved recipe *)
    RECIPE_LE_MAX : BOOL; (* RECIPE <= last approved recipe *)
    RECIPE_VALID : BOOL; (* RECIPE is on the approved list (plc/recipes.py: 1..3) *)
    RECIPE_REJECTED : BOOL; (* A recipe is loaded but not approved: JOB_START is never raised *)
    JOB_COUNT : UINT := 1; (* Next JOB_ID; incremented on DONE *)
    NO_RECIPE : WORD := 0; (* Written to RECIPE when a job is consumed (DONE or FAULT) *)
    LAST_FAULT_CODE : WORD; (* FAULT_CODE latched on the rising edge of FAULT *)
    LAST_PARTS_OK : WORD; (* PARTS_OK latched on DONE *)
    LAST_PARTS_FAILED : WORD; (* PARTS_FAILED latched on DONE *)
  END_VAR
  VAR_EXTERNAL
    ESTOP_OK : BOOL;
    GUARD_CLOSED : BOOL;
    MODE_AUTO : BOOL;
    MOTION_PERMIT : BOOL;
    JOB_START : BOOL;
    FAULT_RESET : BOOL;
    JOB_ID : WORD;
    RECIPE : WORD;
    PLC_HEARTBEAT : WORD;
    READY : BOOL;
    BUSY : BOOL;
    DONE : BOOL;
    FAULT : BOOL;
    DEGRADED : BOOL;
    ROBOT_READY : BOOL;
    FAULT_CODE : WORD;
    PARTS_OK : WORD;
    PARTS_FAILED : WORD;
    SLOT_MASK : WORD;
    ROBOT_HEARTBEAT : WORD;
    JOB_ID_ECHO : WORD;
    CELL_FAULTED : BOOL;
  END_VAR

